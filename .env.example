# SQLite is the default for local development. Prisma also accepts a Postgres URL.
DATABASE_URL="file:./dev.db"

# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# Public origin used for Stripe redirects (no trailing slash)
APP_URL="http://localhost:3000"

# Stripe — Dashboard → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Recurring prices for LanguagePath Pro
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_YEARLY="price_..."

# Stripe CLI: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# Local e2e only (never production). Uncomment to grant Pro via
# POST /api/dev/simulate-checkout — same handler as checkout.session.completed.
# ALLOW_WEBHOOK_MOCK="1"

# GrokBot (conversation partner). Prefer xAI. Without a key, a local beginner
# tutor still replies and the monthly quota still applies. Lessons stay free.
XAI_API_KEY=""
GROK_MODEL="grok-4.7"

# Optional fallback if XAI_API_KEY is unset.
OPENAI_API_KEY=""
